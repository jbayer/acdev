#!/usr/bin/env bash
# Host-side launcher for the acdev Nix binary cache (nginx proxy_cache).
# Renders the bundled nginx template and execs nginx in the foreground.
set -euo pipefail

PORT="${ACDEV_NIX_CACHE_PORT:-8126}"
# Bind to all interfaces by default so the cache comes up regardless of
# container-bridge state: 192.168.64.1 only exists while a container is running,
# so binding it directly fails when you start the cache first. Containers still
# reach the cache via the gateway. Set ACDEV_NIX_CACHE_LISTEN=192.168.64.1 to
# restrict it to the container network (LAN-isolated) — but start a container
# first so the bridge is up. See README.
LISTEN="${ACDEV_NIX_CACHE_LISTEN:-0.0.0.0}"
CACHE_DIR="${ACDEV_NIX_CACHE_DIR:-$HOME/.cache/acdev/nix-cache}"

# Template path: env override (tests) > build-substituted default > repo-relative.
TEMPLATE="${ACDEV_NIX_CACHE_TEMPLATE:-@TEMPLATE_PATH@}"
if [ ! -f "$TEMPLATE" ]; then
  TEMPLATE="$(cd "$(dirname "$0")/.." && pwd)/nix-cache/nginx.conf.template"
fi
[ -f "$TEMPLATE" ] || { printf 'acdev-nix-cache: template not found: %s\n' "$TEMPLATE" >&2; exit 1; }

render() {
  sed -e "s|@PORT@|$PORT|g" -e "s|@LISTEN@|$LISTEN|g" -e "s|@CACHE_DIR@|$CACHE_DIR|g" "$TEMPLATE"
}

# Introspection: render to stdout with no side effects (no dirs, no files).
if [ "${1:-}" = "--print-config" ]; then
  render
  exit 0
fi

mkdir -p "$CACHE_DIR/cache" "$CACHE_DIR/client-tmp" "$CACHE_DIR/proxy-tmp"
rendered="$CACHE_DIR/nginx.conf"
render >"$rendered"
# -e points nginx's early-init error log (opened before the config is parsed) at
# the same writable path as the error_log directive, so it never falls back to
# its compiled-in default (/var/log/nginx/error.log) and logging stays in one place.
exec nginx -e "$CACHE_DIR/error.log" -c "$rendered"
