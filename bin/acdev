#!/usr/bin/env bash
set -euo pipefail

# Single source of truth for the acdev version (3-digit semver). The Flox build
# reads this exact line via `version.command` in .flox/env/manifest.toml, so this
# is the only place to bump the version.
ACDEV_VERSION="0.1.3"

usage() {
  printf 'acdev %s\n\n' "$ACDEV_VERSION"
  cat <<'EOF'
Usage: acdev <command> [options]

Commands:
  init      Create a starter .applecontainer.toml in the current directory
  up        Create or reuse this project's container
  shell     Enter the project's container shell
  status    Show the project's container state
  down      Stop the project's container (--rm to also remove)

Options:
  --dry-run   Print the container commands instead of running them
  --help      Show this help

A project is any directory containing .applecontainer.toml.
EOF
}

# --- output helpers -------------------------------------------------------
# Human-facing status goes to stderr so stdout carries only emitted commands
# (needed for --dry-run assertions).
emit() { printf '%s\n' "$*" >&2; }
die()  { printf 'acdev: %s\n' "$*" >&2; exit 1; }

DRY_RUN=0

# Run a `container` subcommand, or print it under --dry-run.
container_do() {
  if [ "$DRY_RUN" = 1 ]; then
    echo "container $*"
  else
    command container "$@"
  fi
}

# --- config ---------------------------------------------------------------
# Hard-coded default image written by `acdev init` (digest-pinned for reproducibility).
DEFAULT_IMAGE="jbayer/devcontainer-flox:1.12.1@sha256:ce5b46c215b06ca580a02fa4793d929855a4b8e3a9d7acd4d47662a4a29be4a3"

# Globals populated by resolve_config:
CFG_IMAGE=""; CFG_USER=""; CFG_WORKSPACE=""; CFG_SHELL=""; CFG_FLOX=""; CFG_NIX_CACHE=""
CFG_ENV=()   # array of "KEY=VALUE"

# Strip surrounding double quotes and edge whitespace.
_unquote() {
  local v="$1"
  v="${v#"${v%%[![:space:]]*}"}"   # ltrim
  v="${v%"${v##*[![:space:]]}"}"   # rtrim
  v="${v#\"}"; v="${v%\"}"
  printf '%s' "$v"
}

resolve_config() {
  [ -f .applecontainer.toml ] || die "no .applecontainer.toml in $(pwd)"
  local section="" line key val
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"                      # drop comments
    line="${line#"${line%%[![:space:]]*}"}" # ltrim
    [ -z "$line" ] && continue
    if [[ "$line" =~ ^\[(.+)\]$ ]]; then
      section="${BASH_REMATCH[1]}"
      continue
    fi
    key="${line%%=*}"; val="${line#*=}"
    key="$(_unquote "$key")"; val="$(_unquote "$val")"
    if [ "$section" = "env" ]; then
      CFG_ENV+=("$key=$val")
    else
      case "$key" in
        image)     CFG_IMAGE="$val" ;;
        user)      CFG_USER="$val" ;;
        workspace) CFG_WORKSPACE="$val" ;;
        shell)     CFG_SHELL="$val" ;;
        flox)      CFG_FLOX="$val" ;;
        nix_cache) CFG_NIX_CACHE="$val" ;;
      esac
    fi
  done < .applecontainer.toml

  [ -n "$CFG_IMAGE" ] || die "config error: 'image' is required in .applecontainer.toml"
  [ -n "$CFG_SHELL" ] || CFG_SHELL="bash"
  [ -n "$CFG_FLOX" ]  || CFG_FLOX="auto"
  if [ -z "$CFG_WORKSPACE" ]; then
    CFG_WORKSPACE="/workspaces/$(basename "$(pwd -P)")"
  fi
}

# Stable per-project container name: acdev-<basename>-<8 hex of abs path>.
container_name() {
  local abs base hash
  abs="$(pwd -P)"
  # printf (no trailing newline) before tr; otherwise tr maps basename's
  # trailing \n to '-', producing a spurious double dash in the name.
  base="$(printf '%s' "$(basename "$abs")" | tr -c 'A-Za-z0-9_.-' '-')"
  hash="$(printf '%s' "$abs" | shasum -a 256 | cut -c1-8)"
  printf 'acdev-%s-%s' "$base" "$hash"
}

preflight() {
  if ! command -v container >/dev/null 2>&1; then
    die "the 'container' CLI was not found. Install Apple Container (apple/container) and ensure it is on your PATH."
  fi
  # Probe the daemon with a cheap call; translate the common failure.
  if ! command container ls >/dev/null 2>&1; then
    die "cannot reach the container service. Start it with: container system start"
  fi
}

# Echoes: running | stopped | absent
container_state() {
  local name="$1"
  if command container ls 2>/dev/null | grep -qw -- "$name"; then
    echo running
  elif command container ls --all 2>/dev/null | grep -qw -- "$name"; then
    echo stopped
  else
    echo absent
  fi
}

# True (0) when the host nix-cache proxy answers with its banner on loopback.
# Probed from the host (where `acdev init` runs); the container reaches the same
# proxy via the bridge gateway 192.168.64.1.
_nix_cache_running() {
  command -v curl >/dev/null 2>&1 || return 1
  local port="${ACDEV_NIX_CACHE_PORT:-8126}"
  curl -fsS --max-time 1 "http://127.0.0.1:${port}/" 2>/dev/null \
    | grep -q 'acdev nix-cache proxy'
}

# Create a starter .applecontainer.toml in the CWD (no-op if one already exists).
cmd_init() {
  local cfg=".applecontainer.toml"
  if [ -f "$cfg" ]; then
    emit "acdev: $cfg already exists in $(pwd) — nothing to do."
    return 0
  fi
  # If the shared nix-cache proxy is up, wire the project to it (active line);
  # otherwise leave the same line commented as a hint.
  local port="${ACDEV_NIX_CACHE_PORT:-8126}" cache_line detected=0
  if _nix_cache_running; then
    detected=1
    cache_line="nix_cache = \"http://192.168.64.1:${port}\"  # detected host nix-cache proxy (see README)"
  else
    cache_line="# nix_cache = \"http://192.168.64.1:${port}\"  # use the host nix-cache proxy (see README)"
  fi
  cat >"$cfg" <<EOF
# acdev project config — makes this directory acdev-managed.
# The image is digest-pinned for reproducibility; the rest are optional and
# show their defaults, commented out. Uncomment and edit to override.
image = "$DEFAULT_IMAGE"

# user      = "flox"                # exec/run as this user
# workspace = "/workspaces/<dir>"   # default: /workspaces/<basename of this dir>
# shell     = "bash"                # shell to drop into
# flox      = "auto"                # auto = activate iff .flox/ exists; true/false to force
$cache_line

# Environment variables passed into the container:
# [env]
# EXAMPLE = "value"
EOF
  emit "✔ created $cfg"
  [ "$detected" = 1 ] && emit "  ↳ detected the host nix-cache proxy on :$port — enabled nix_cache."
  emit "  'acdev up' will attempt to start it; 'acdev shell' will attempt to enter it."
}

cmd_up() {
  resolve_config
  local name; name="$(container_name)"
  emit "🍎 acdev: project '$(basename "$(pwd -P)")'  ($name)"
  emit "   image     $CFG_IMAGE"
  emit "   workspace $(pwd -P) → $CFG_WORKSPACE"

  # Under --dry-run we can't probe a real daemon; just emit the create command.
  if [ "$DRY_RUN" = 1 ]; then
    _up_create "$name"; return 0
  fi

  preflight
  case "$(container_state "$name")" in
    running)
      emit "✔ reusing running container" ;;
    stopped)
      container_do start "$name" >/dev/null
      emit "✔ restarted container" ;;
    absent)
      _up_create "$name" >/dev/null
      emit "✔ created container" ;;
  esac
}

_up_create() {
  local name="$1"
  local args=(run -d --name "$name" -v "$(pwd -P):$CFG_WORKSPACE" -w "$CFG_WORKSPACE")
  [ -n "$CFG_USER" ] && args+=(--user "$CFG_USER")
  local kv
  for kv in "${CFG_ENV[@]:-}"; do
    [ -n "$kv" ] && args+=(-e "$kv")
  done
  if [ -n "$CFG_NIX_CACHE" ]; then
    local base="${CFG_NIX_CACHE%/}"   # strip a single trailing slash
    args+=(-e "NIX_CONFIG=extra-substituters = $base/flox?priority=1 $base/nixos?priority=2")
  fi
  args+=("$CFG_IMAGE" sleep infinity)
  container_do "${args[@]}"
}

cmd_down() {
  resolve_config
  [ "$DRY_RUN" != 1 ] && preflight
  local name rm=0 a
  name="$(container_name)"
  for a in "$@"; do [ "$a" = "--rm" ] && rm=1; done
  container_do stop "$name" >/dev/null 2>&1 || true
  emit "✔ stopped $name"
  if [ "$rm" = 1 ]; then
    container_do rm "$name" >/dev/null 2>&1 || true
    emit "✔ removed $name"
  fi
}

cmd_status() {
  resolve_config
  [ "$DRY_RUN" != 1 ] && preflight
  local name state line ip
  name="$(container_name)"
  state="$(container_state "$name")"
  printf 'project   %s\n' "$(basename "$(pwd -P)")"
  printf 'container %s\n' "$name"
  printf 'state     %s\n' "$state"
  printf 'image     %s\n' "$CFG_IMAGE"
  printf 'workspace %s → %s\n' "$(pwd -P)" "$CFG_WORKSPACE"
  if [ "$state" = running ]; then
    # IP is the ADDR column (6th field) of the matching `container ls` row:
    # "ID IMAGE OS ARCH STATE ADDR CPUS MEMORY STARTED". Real ADDR carries a
    # CIDR suffix (e.g. "192.168.64.3/24"); strip it to a bare IP.
    line="$(command container ls 2>/dev/null | grep -w -- "$name" | head -n1)"
    ip="$(printf '%s' "$line" | awk '{print $6}')"
    ip="${ip%%/*}"
    [ -n "$ip" ] && printf 'ip        %s\n' "$ip"
  fi
}

# Build the in-container entry command honoring CFG_FLOX and CFG_SHELL.
# flox activation sets FLOX_SHELL so flox can pick the shell: inside the
# container $SHELL is unset and `exec` replaces the launching shell, so flox's
# usual detection (parent process, then $SHELL) fails and warns. FLOX_SHELL is
# checked first and short-circuits that cleanly.
_entry_script() {
  case "$CFG_FLOX" in
    true)  printf 'exec env FLOX_SHELL=%s flox activate' "$CFG_SHELL" ;;
    false) printf 'exec %s -l' "$CFG_SHELL" ;;
    *)     printf 'if [ -d .flox ]; then exec env FLOX_SHELL=%s flox activate; else exec %s -l; fi' "$CFG_SHELL" "$CFG_SHELL" ;;
  esac
}

cmd_shell() {
  resolve_config
  local name; name="$(container_name)"
  emit "→  entering shell (flox: $CFG_FLOX)"
  ACDEV_INSIDE=1 container_do exec -it -w "$CFG_WORKSPACE" "$name" \
    "$CFG_SHELL" -lc "ACDEV_INSIDE=1; $(_entry_script)"
}

main() {
  local cmd="" rest=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --help|-h) usage; return 0 ;;
      --version|-v) printf 'acdev %s\n' "$ACDEV_VERSION"; return 0 ;;
      init|up|shell|status|down) cmd="$1" ;;
      *) rest+=("$1") ;;
    esac
    shift
  done
  case "$cmd" in
    init)   cmd_init "${rest[@]:-}" ;;
    up)     cmd_up "${rest[@]:-}" ;;
    shell)  cmd_shell "${rest[@]:-}" ;;
    status) cmd_status "${rest[@]:-}" ;;
    down)   cmd_down "${rest[@]:-}" ;;
    "") usage >&2; return 2 ;;
    *)  usage >&2; return 2 ;;
  esac
}

main "$@"
