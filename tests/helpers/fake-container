#!/usr/bin/env bash
# Test double for Apple's `container` CLI. Output layout matches real
# container 1.5.0 (`ls` was first modeled on 0.12.3, where IP was named ADDR).
# - Records argv (one line per call) to $ACDEV_FAKE_LOG.
# - Simulates state via $ACDEV_FAKE_STATE: absent | stopped | running.
#   `container ls`        lists RUNNING containers only.
#   `container ls --all`  lists ALL containers (running + stopped).
# The "name" reported is taken from $ACDEV_FAKE_NAME if set.
#
# Real `container ls` is a 9-column table with a header row:
#   ID  IMAGE  OS  ARCH  STATE  IP  CPUS  MEMORY  STARTED
# IP is column 6 and carries a CIDR suffix (e.g. 192.168.64.3/24);
# a stopped container's IP is blank. This fake reproduces that layout so
# container_state (greps the name) and cmd_status (reads the IP column)
# are exercised against the real format.
#
# `container inspect <name>` returns pretty-printed JSON like container 1.5.0,
# with the image digest at configuration.image.descriptor.digest. It fails with
# "container not found" when the container is absent.
set -euo pipefail
echo "$*" >>"${ACDEV_FAKE_LOG:-/dev/null}"

if [ "${ACDEV_FAKE_STATE:-}" = "daemon_down" ]; then
  echo "Cannot connect to the container service" >&2
  exit 1
fi

state="${ACDEV_FAKE_STATE:-absent}"
name="${ACDEV_FAKE_NAME:-}"
ts="2026-06-01T00:00:00Z"

case "$1" in
  ls)
    all=0; [[ "$*" == *"--all"* ]] && all=1
    printf 'ID  IMAGE  OS  ARCH  STATE  IP  CPUS  MEMORY  STARTED\n'
    case "$state" in
      running) [ -n "$name" ] && \
        printf '%s docker.io/img:1 linux arm64 running 192.168.64.42/24 4 1024 MB %s\n' "$name" "$ts" ;;
      stopped) [ "$all" = 1 ] && [ -n "$name" ] && \
        printf '%s docker.io/img:1 linux arm64 stopped  4 1024 MB %s\n' "$name" "$ts" ;;
      absent)  : ;;
    esac
    ;;
  inspect)
    if [ "$state" = absent ] || [ "${2:-}" != "$name" ]; then
      echo "Error: container not found: ${2:-}" >&2
      exit 1
    fi
    cat <<JSON
[
  {
    "configuration" : {
      "id" : "$name",
      "image" : {
        "descriptor" : {
          "digest" : "sha256:${ACDEV_FAKE_DIGEST:-a994b4024250c41fc5fd0d387c603adca30e978378a4cba7027a39ad30c61d9b}",
          "mediaType" : "application/vnd.oci.image.index.v1+json",
          "size" : 856
        },
        "reference" : "docker.io/img:1"
      }
    },
    "id" : "$name",
    "status" : "$state"
  }
]
JSON
    ;;
  *) : ;;   # run/start/stop/exec/etc. just get logged
esac
exit 0
